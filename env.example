# Chuỗi kết nối Postgres (Neon / Vercel Postgres / Supabase...)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Chuỗi ngẫu nhiên dài (>= 32 ký tự) để ký JWT
JWT_SECRET=change-me-to-a-long-random-string
# Mã bí mật để gọi /api/setup (tạo bảng + dữ liệu mẫu)
SETUP_TOKEN=change-me-too
